# Copy to .env. Loaded automatically by backend and UI. Never commit .env.
VERIFIER_API_URL=http://127.0.0.1:8000
# Optional, recommended whenever not bound exclusively to localhost.
# VERIFIER_API_TOKEN=use-a-long-random-secret
# VERIFIER_DASHBOARD_PASSWORD=use-another-long-random-secret
# VERIFIER_DATA=/absolute/path/to/private/data
ENGINE_TIMEOUT=90
# Optional live provider credentials. Profile contains only the variable NAME.
# AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
